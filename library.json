{
  "name": "AyresWiFiManager",
  "version": "3.0.0",
  "description": "ESP32 WiFi manager for network provisioning with a captive portal, automatic reconnection, LittleFS credential storage, optional encryption, NTP and connectivity diagnostics.",
  "keywords": "esp32,wifi,wi-fi,wifimanager,wifi-manager,provisioning,captive-portal,softap,webserver,dns,littlefs,credentials,encryption,reconnect,ntp,iot",
  "authors": [
    {
      "name": "Daniel Salgado",
      "maintainer": true,
      "url": "https://github.com/ayresnet"
    },
    {
      "name": "AyresNet"
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/ayresnet/AyresWiFiManager",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayresnet/AyresWiFiManager.git"
  },
  "frameworks": "arduino",
  "platforms": "espressif32",
  "headers": [
    "AyresWiFiManager.h"
  ],
  "dependencies": [
    {
      "name": "ArduinoJson",
      "owner": "bblanchon",
      "version": "^6.21.2"
    }
  ],
  "examples": [
    "examples/*/*"
  ],
  "export": {
    "exclude": [
      ".github",
      "test",
      "docs",
      "extras",
      "src/main.cpp",
      "*.zip"
    ]
  }
}
